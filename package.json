{
  "name": "sg-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && next-sitemap && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "dev": "./restart.sh --local",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --tsconfig=tsconfig.json --type-aware",
    "lint-staged": "lint-staged",
    "lint:fix": "oxlint . --tsconfig=tsconfig.json --type-aware --fix",
    "local-db:down": "docker compose --env-file .env --env-file .env.local -f docker-compose.local.yaml down",
    "local-db:up": "docker compose --env-file .env --env-file .env.local -f docker-compose.local.yaml up --remove-orphans -d",
    "postinstall": "husky",
    "seed:globals": "yarn local-db:up && bash -c 'set -a; source .env; yarn dlx --quiet tsx src/migrations/seed-globals.ts' && yarn local-db:down || yarn local-db:down",
    "start": "yarn local-db:up && node .next/standalone/server.js && yarn local-db:down",
    "test": "yarn local-db:up && yarn build && yarn local-db:down && playwright test",
    "test:only": "playwright test",
    "test:quick": "yarn local-db:up && yarn build && yarn local-db:down && playwright test e2e/visual.spec.ts --project \"Desktop Chrome\"",
    "test:ui": "playwright test --ui-host localhost",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@payloadcms/db-mongodb": "^3.77.0",
    "@payloadcms/next": "^3.77.0",
    "@payloadcms/richtext-lexical": "^3.77.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "graphql": "^16.13.0",
    "libphonenumber-js": "^1.12.38",
    "next": "16.1.6",
    "payload": "^3.77.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/next": "^2.0.6",
    "@types/node": "^24.10.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "next-sitemap": "^4.2.3",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.12.0"
}
